# TigerData (Tiger Cloud Postgres + TimescaleDB, pgvector, pgvectorscale)
# App runtime: use the POOLED connection string (Tiger console > service > Connect > Connection pooler)
DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<pooler-port>/tsdb?sslmode=require
# Migrations, seed and embedding loads: use the DIRECT connection string
DATABASE_URL_DIRECT=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# Server-only vendor keys
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=

# Required by the Worker binding list (local: .dev.vars / .env.local). Use any long random string.
TRY_IT_SECRET=
TELL_TOOL_SECRET=
# From ElevenLabs → Workspace → Webhooks → signing secret (wsec_…)
ELEVENLABS_WEBHOOK_SECRET=

# Phone test calls (team only). Free path: Twilio trial + ElevenLabs Agents free minutes.
# 1) Twilio trial number + verify the personal phone under Verified Caller IDs.
# 2) Import with: npm run voice:import-twilio   (or Phone Numbers > Import > Twilio in the UI)
# 3) Put the printed ID here. Set ELEVENLABS_PHONE_PROVIDER=sip_trunk only for Photon.
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_PHONE_PROVIDER=twilio
# Comma-separated E.164 numbers of team members who agreed to test calls. Nothing else is dialled.
# On a Twilio trial this must be a Verified Caller ID in the Twilio console.
TELL_TEAM_PHONES=
# Used only by npm run voice:import-twilio (not needed at runtime once imported).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

